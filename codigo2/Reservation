{
  "name": "Reservation",
  "type": "object",
  "properties": {
    "area": {
      "type": "string",
      "enum": [
        "party_room",
        "bbq",
        "pool",
        "gym",
        "playground",
        "meeting_room",
        "other"
      ],
      "description": "\u00c1rea comum"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data da reserva"
    },
    "start_time": {
      "type": "string",
      "description": "Hor\u00e1rio de in\u00edcio"
    },
    "end_time": {
      "type": "string",
      "description": "Hor\u00e1rio de t\u00e9rmino"
    },
    "unit_number": {
      "type": "string",
      "description": "Unidade do solicitante"
    },
    "resident_name": {
      "type": "string",
      "description": "Nome do morador"
    },
    "purpose": {
      "type": "string",
      "description": "Finalidade da reserva"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ],
      "default": "pending",
      "description": "Status da reserva"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "area",
    "date",
    "unit_number",
    "resident_name"
  ]
}