{
  "name": "WorkOrder",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da ordem de servi\u00e7o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "type": {
      "type": "string",
      "enum": [
        "maintenance",
        "repair",
        "cleaning",
        "inspection",
        "installation",
        "other"
      ],
      "description": "Tipo de servi\u00e7o"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "assigned",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "open",
      "description": "Status da OS"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "assigned_to": {
      "type": "string",
      "description": "Respons\u00e1vel / empresa"
    },
    "unit_number": {
      "type": "string",
      "description": "Unidade relacionada"
    },
    "estimated_cost": {
      "type": "number",
      "description": "Custo estimado em reais"
    },
    "actual_cost": {
      "type": "number",
      "description": "Custo real em reais"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Prazo"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "Data de conclus\u00e3o"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}