{
  "name": "GateEntry",
  "type": "object",
  "properties": {
    "visitor_name": {
      "type": "string",
      "description": "Nome do visitante"
    },
    "visitor_document": {
      "type": "string",
      "description": "Documento do visitante"
    },
    "unit_number": {
      "type": "string",
      "description": "Unidade visitada"
    },
    "purpose": {
      "type": "string",
      "description": "Motivo da visita"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "authorized",
        "entered",
        "exited",
        "denied"
      ],
      "default": "pending",
      "description": "Status da entrada"
    },
    "authorized_by": {
      "type": "string",
      "description": "Autorizado por (morador/porteiro)"
    },
    "vehicle_plate": {
      "type": "string",
      "description": "Placa do ve\u00edculo"
    },
    "entry_time": {
      "type": "string",
      "format": "date-time",
      "description": "Hor\u00e1rio de entrada"
    },
    "exit_time": {
      "type": "string",
      "format": "date-time",
      "description": "Hor\u00e1rio de sa\u00edda"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "visitor_name",
    "unit_number"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}