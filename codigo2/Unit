{
  "name": "Unit",
  "type": "object",
  "properties": {
    "number": {
      "type": "string",
      "description": "N\u00famero da unidade (ex: 101, Casa 5)"
    },
    "block": {
      "type": "string",
      "description": "Bloco ou torre"
    },
    "type": {
      "type": "string",
      "enum": [
        "apartment",
        "house",
        "commercial"
      ],
      "default": "apartment",
      "description": "Tipo da unidade"
    },
    "owner_name": {
      "type": "string",
      "description": "Nome do propriet\u00e1rio"
    },
    "owner_email": {
      "type": "string",
      "description": "Email do propriet\u00e1rio"
    },
    "owner_phone": {
      "type": "string",
      "description": "Telefone do propriet\u00e1rio"
    },
    "resident_name": {
      "type": "string",
      "description": "Nome do morador (se diferente do propriet\u00e1rio)"
    },
    "resident_phone": {
      "type": "string",
      "description": "Telefone do morador"
    },
    "status": {
      "type": "string",
      "enum": [
        "occupied",
        "vacant",
        "rented"
      ],
      "default": "occupied",
      "description": "Status da unidade"
    },
    "area_sqm": {
      "type": "number",
      "description": "\u00c1rea em metros quadrados"
    }
  },
  "required": [
    "number"
  ]
}