{
  "name": "Delivery",
  "type": "object",
  "properties": {
    "recipient_name": {
      "type": "string",
      "description": "Nome do destinat\u00e1rio"
    },
    "unit_number": {
      "type": "string",
      "description": "Unidade de destino"
    },
    "carrier": {
      "type": "string",
      "enum": [
        "correios",
        "sedex",
        "jadlog",
        "dhl",
        "amazon",
        "direct",
        "other"
      ],
      "description": "Transportadora"
    },
    "tracking_code": {
      "type": "string",
      "description": "C\u00f3digo de rastreio"
    },
    "status": {
      "type": "string",
      "enum": [
        "received",
        "picked_up",
        "returned"
      ],
      "default": "received",
      "description": "Status da entrega"
    },
    "received_by": {
      "type": "string",
      "description": "Recebido por (porteiro)"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "recipient_name",
    "unit_number"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}