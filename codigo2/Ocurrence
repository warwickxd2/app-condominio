{
  "name": "Occurrence",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da ocorr\u00eancia"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "category": {
      "type": "string",
      "enum": [
        "complaint",
        "maintenance",
        "suggestion",
        "noise",
        "parking",
        "security",
        "other"
      ],
      "description": "Categoria"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "description": "Prioridade"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open",
      "description": "Status"
    },
    "unit_number": {
      "type": "string",
      "description": "Unidade do solicitante"
    },
    "reporter_name": {
      "type": "string",
      "description": "Nome do solicitante"
    },
    "resolution_notes": {
      "type": "string",
      "description": "Notas de resolu\u00e7\u00e3o"
    }
  },
  "required": [
    "title",
    "category"
  ]
}