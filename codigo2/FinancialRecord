{
  "name": "FinancialRecord",
  "type": "object",
  "properties": {
    "unit_id": {
      "type": "string",
      "description": "ID da unidade"
    },
    "unit_number": {
      "type": "string",
      "description": "N\u00famero da unidade para exibi\u00e7\u00e3o"
    },
    "type": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "description": "Tipo: receita ou despesa"
    },
    "category": {
      "type": "string",
      "enum": [
        "condo_fee",
        "water",
        "gas",
        "maintenance",
        "cleaning",
        "security",
        "elevator",
        "garden",
        "salary",
        "insurance",
        "other"
      ],
      "description": "Categoria do lan\u00e7amento"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do lan\u00e7amento"
    },
    "amount": {
      "type": "number",
      "description": "Valor em reais"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "Data do pagamento"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "pending",
      "description": "Status do pagamento"
    },
    "reference_month": {
      "type": "string",
      "description": "M\u00eas de refer\u00eancia (ex: 2025-01)"
    }
  },
  "required": [
    "type",
    "category",
    "amount"
  ]
}