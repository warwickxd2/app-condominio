{
  "name": "Maintenance",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da manuten\u00e7\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "category": {
      "type": "string",
      "enum": [
        "elevator",
        "electrical",
        "hydraulic",
        "structural",
        "painting",
        "garden",
        "pool",
        "security",
        "cleaning",
        "other"
      ],
      "description": "Categoria"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "done"
      ],
      "default": "not_started",
      "description": "Status da manuten\u00e7\u00e3o"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    },
    "responsible": {
      "type": "string",
      "description": "Respons\u00e1vel / empresa"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "cost": {
      "type": "number",
      "description": "Custo em reais"
    },
    "notes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es ou hist\u00f3rico"
    },
    "completion_report": {
      "type": "string",
      "description": "Relat\u00f3rio de conclus\u00e3o"
    }
  },
  "required": [
    "title",
    "category"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}